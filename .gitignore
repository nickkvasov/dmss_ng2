# Generated schema files (exclude all generated schemas)
ingestors/nebula/schema/*.ngql
ingestors/nebula/schema/nebula_*_schema.ngql
ingestors/nebula/schema/nebula_*_schema_*.ngql
ingestors/nebula/schema/*_schema.ngql
ingestors/nebula/schema/*_schema_*.ngql

# Keep schema directory README but exclude generated files
!ingestors/nebula/schema/README.md

# Exclude any other generated schema directories
**/schema/*.ngql
**/schema/*_schema.ngql
**/schema/*_schema_*.ngql

# YAML files - exclude all by default, then include specific ones
*.yaml
*.yml
!docker-compose*.yaml
!docker-compose*.yml
!Chart.yaml
!values.yaml
!*.tpl

# Include ontology YAML files (essential source files)
!ontology/**/*.yaml
!ontology/**/*.yml

# Include ingestion configuration files (essential source files)
!ingestors/**/config.yaml
!ingestors/**/config.yml
!ingestors/**/*.yaml
!ingestors/**/*.yml

# Include generator configuration files (essential source files)
!generators/**/config.yaml
!generators/**/config.yml
!generators/**/*.yaml
!generators/**/*.yml

# Include test configuration files
!tests/**/*.yaml
!tests/**/*.yml

# Include documentation YAML files
!docs/**/*.yaml
!docs/**/*.yml

