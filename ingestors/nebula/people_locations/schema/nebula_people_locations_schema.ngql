-- Create space for People Locations data
CREATE SPACE people_locations_space (partition_num = 10, replica_factor = 1, vid_type = FIXED_STRING(32));
USE people_locations_space;

-- Tag definitions (vertices)
CREATE TAG POSITION_PING (
    event_id string,
    person_id string,
    lat double,
    lon double,
    timestamp timestamp,
    accuracy double NULL
);

CREATE TAG TICKET_ENTRY (
    event_id string,
    person_id string,
    poi_id string,
    timestamp timestamp,
    ticket_class string NULL
);

-- Edge definitions (relationships)
CREATE EDGE EMITTED (
    source string NULL,
    confidence double NULL
);

CREATE EDGE ENTERED (
    entry_method string NULL,
    gate_id string NULL
);

CREATE EDGE AT_POI (
    distance double NULL,
    association_type string NULL
);

