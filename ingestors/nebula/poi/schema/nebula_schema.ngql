-- Nebula Graph Schema for POI Ontology
-- Generated from: ../../../ontology/poi/poi_ontology.yaml
-- Generated at: 2025-08-26T01:21:04.907526

-- Create space for POI data
CREATE SPACE poi_space (partition_num = 10, replica_factor = 1, vid_type = FIXED_STRING(32));
USE poi_space;

-- Tag definitions (vertices)
CREATE TAG POI (
    poi_id string,
    name string,
    category string,
    lat double,
    lon double,
    address string NULL,
    description string NULL,
    rating double NULL,
    opening_hours string NULL,
    capacity int NULL
);

CREATE TAG POI_TYPE (
    type_id string,
    name string,
    description string NULL,
    category string NULL
);

-- Edge definitions (relationships)
CREATE EDGE IS_OF_TYPE (
    confidence double NULL
);

-- Indexes for performance
CREATE TAG INDEX poi_location_idx ON POI(lat, lon);
CREATE TAG INDEX poi_category_idx ON POI(category);
CREATE TAG INDEX poi_type_name_idx ON POI_TYPE(name);
