    lon double,
    address string NULL,
    description string NULL,
    rating double NULL,
    opening_hours string NULL,
    capacity int NULL
);

CREATE TAG POI_TYPE (
    type_id string,
    name string,
    description string NULL,
    category string NULL
);

-- DOMAIN/PEOPLE ONTOLOGY
CREATE TAG PERSON (
    person_id string,
    sex string NULL,
    age int NULL,
    wealth string NULL,
    created_at timestamp NULL
);

CREATE TAG PERSON_ROLE (
    role_id string,
    name string,
    description string NULL,
    category string NULL
);

-- SYSTEM/PEOPLE_DETECTIONS ONTOLOGY
CREATE TAG POSITION_PING (
    event_id string,
    person_id string,
    lat double,
    lon double,
    event_timestamp timestamp,
    accuracy double NULL
);

CREATE TAG TICKET_ENTRY (
    event_id string,
    person_id string,
    poi_id string,
    entry_timestamp timestamp,
    ticket_class string NULL
);

-- APP ONTOLOGY
CREATE TAG ANOMALY (
    anomaly_id string,
    anomaly_type string,
    severity string,
    confidence double,
    detected_at timestamp,
    description string NULL,
    location_lat double NULL,
    location_lon double NULL,
    time_window_start timestamp NULL,
    time_window_end timestamp NULL
);

CREATE TAG ALERT (
    alert_id string,
    alert_type string,
    priority string,
    status string,
    created_at timestamp,
    acknowledged_at timestamp NULL,
    resolved_at timestamp NULL,
    message string,
    recipients string NULL
);

CREATE TAG ANOMALY_PATTERN (
    pattern_id string,
    pattern_name string,
    pattern_type string,
    description string NULL,
    parameters string NULL,
    is_active bool,
    created_at timestamp
);

-- Edge definitions (relationships) from all ontologies
-- DOMAIN/POI ONTOLOGY
CREATE EDGE IS_OF_TYPE (
    confidence double NULL
);

-- DOMAIN/PEOPLE ONTOLOGY
CREATE EDGE HAS_ROLE (
    assigned_date timestamp NULL,
    is_primary bool NULL,
    context string NULL
);

