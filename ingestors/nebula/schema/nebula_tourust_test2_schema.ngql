-- Create unified space for all data
CREATE SPACE tourust_test2 (partition_num = 10, replica_factor = 1, vid_type = FIXED_STRING(32));
USE tourust_test2;

-- Tag definitions (vertices) from all ontologies
-- POI ONTOLOGY
CREATE TAG POI (
    poi_id string,
    name string,
    category string,
    lat double,
    lon double,
    address string NULL,
    description string NULL,
    rating double NULL,
    opening_hours string NULL,
    capacity int NULL
);

CREATE TAG POI_TYPE (
    type_id string,
    name string,
    description string NULL,
    category string NULL
);

-- PEOPLE ONTOLOGY
CREATE TAG PERSON (
    person_id string,
    sex string NULL,
    age int NULL,
    wealth string NULL,
    created_at timestamp NULL
);

CREATE TAG PERSON_ROLE (
    role_id string,
    name string,
    description string NULL,
    category string NULL
);

-- PEOPLE_LOCATIONS ONTOLOGY
CREATE TAG POSITION_PING (
    event_id string,
    person_id string,
    lat double,
    lon double,
    event_timestamp timestamp,
    accuracy double NULL
);

CREATE TAG TICKET_ENTRY (
    event_id string,
    person_id string,
    poi_id string,
    entry_timestamp timestamp,
    ticket_class string NULL
);

-- Edge definitions (relationships) from all ontologies
-- POI ONTOLOGY
CREATE EDGE IS_OF_TYPE (
    confidence double NULL
);

-- PEOPLE ONTOLOGY
CREATE EDGE HAS_ROLE (
    assigned_date timestamp NULL,
    is_primary bool NULL,
    context string NULL
);

-- PEOPLE_LOCATIONS ONTOLOGY
CREATE EDGE EMITTED (
    source string NULL,
    confidence double NULL
);

CREATE EDGE ENTERED (
    entry_method string NULL,
    gate_id string NULL
);

CREATE EDGE AT_POI (
    distance double NULL,
    association_type string NULL
);

